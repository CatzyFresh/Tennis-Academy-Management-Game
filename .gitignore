################################################################################
# Unity 6.x – Tennis Academy Management Game
# Repo layout:
#   .git/
#   .gitignore
#   LICENSE
#   README.md
#   Tennis Academy Manager Project/   ← actual Unity project folder
#
# Philosophy:
# - Commit:  Assets/, Packages/, ProjectSettings/, .editorconfig, .gitignore, etc.
# - Ignore:  Anything regenerated by Unity, IDEs, CI, or build tools.
################################################################################

################################
# 1. CORE UNITY GENERATED DATA #
################################

# Unity local cache – HUGE. Always ignored.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/
[Aa]rtifacts/

# Visual Scripting generated stuff (safe to regenerate)
UnityGenerated/
*.generated.cs

# Burst / IL2CPP / shader cache (all regenerated)
[Bb]urstCache/
*.burst
*.burst2
*.il2cpp*
*.cpp.meta
*.h.meta
*.hpp.meta
*.bc
*.bc.meta
*.srgc
*.srgc.meta

# Lightmap & GI caches (usually under Library, but extra safety)
**/LightmapSnapshot.asset
**/LightingData.asset

# Unity profiler / crash dumps
*.dmp
*.crash
*.stacktrace
*.psess
*.vsp
*.vspx
*.sap


###############################
# 2. BUILD OUTPUTS & BINARIES #
###############################

# Generic build folders
[Bb]uild/
[Bb]uilds/
[Bb]in/
[Bb]inaries/
build/
builds/
bin/

# Unity Export Package temp / artifacts
*.unitypackage

# Standalone players
*.exe
*.app
*.x86
*.x86_64

# Mobile builds
*.apk
*.aab
*.ipa

# WebGL / web builds
WebGL/
webgl/
webgl-build/
dist/
deploy/
public-build/
public_webgl/

# iOS / Xcode
xcuserdata/
DerivedData/
*.xcworkspace
*.xcuserstate
*.xcuserdatad

# UWP / Windows Store
*.appx
*.appxbundle
*.appxupload


#################################
# 3. CI / TEST / COVERAGE STUFF #
#################################

# CI / build artifacts
CI/
ci/
.build/
.builds/
.cache/
Cache/
.cache-unity/
coverage/
CoverageResults/

# Test runners
TestResults/
*.coverage
*.coveragexml
*.opencover.xml
*.xml.coverage


###################################
# 4. IDE / EDITOR-SPECIFIC FILES  #
###################################

# --- Visual Studio & VS for Mac ---
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates
*.vcxproj
*.vcxproj.filters
*.ruleset

# VS cache / db
*.VC.db
*.VC.VC.opendb

# MonoDevelop / legacy
*.pidb
*.userprefs

# --- JetBrains Rider / IntelliJ / Android Studio ---
.idea/
*.sln.iml
*.ipr
*.iws
out/
.idea_modules/

# Rider’s solution-wide caches
.project/
.cache/
.gradle/

# --- VS Code ---
.vscode/
.history/
*.code-workspace

# Generic editor temp
*.swp
*.swa
*~


#################################
# 5. UNITY / EDITOR META GUNK   #
#################################

# Temporary / backup / debug symbols
*.tmp
*.bak
*.old
*.orig
*.mdb
*.pdb


#################################
# 6. TOOLING / PACKAGE FOLDERS  #
#################################

# Node / npm / yarn / pnpm / bun
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
pnpm-lock.yaml
bun.lockb

# Python tooling
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Shell temp & logs
*.sh~
*.bat~
*.cmd~
*.log


#######################################
# 7. OS & FILESYSTEM SPECIFIC JUNK    #
#######################################

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
.fseventsd
.apdisk

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.nfs*


#################################################
# 8. COMMON UNITY 3RD-PARTY / PLUGIN PATTERNS   #
#################################################
# NOTE:
# - Keep plugin source in Assets (e.g., DOTween, Cinemachine, TextMesh Pro).
# - Ignore *only* their generated caches or build artifacts.

# DOTween (if using)
[Oo]bj-DOTween/
[Oo]bj-Demigiant/
[Bb]uilds-DOTween/

# Hot Reload for Unity (Singularity Group) — ignore embedded package folder
Tennis Academy Manager/Packages/com.singularitygroup.hotreload/


# Addressables – keep data, ignore build cache
# (By default, Addressables builds into Library; if you configure
#  a custom path, add it here.)
AddressablesCache/
ServerDataCache/

# Custom editor tools (e.g., SmartAssetOrganizer, internal tools)
# - Keep the tool source in Assets/Editor or similar.
# - Ignore tool-specific cache/output if you create them (examples below).
ToolCache/
ToolTemp/
*.toolcache
*.tooltemp


###############################################
# 9. LOCAL CONFIG / ENVIRONMENT OVERRIDES     #
###############################################

# Local override files that vary per machine
*.local
*.dev
*.env
.env.local
.env.development.local
.env.production.local
.env.test.local

# Rider / VS / VS Code workspace-local settings
*.DotSettings.user


################################################
# 10. SAFETY – DO NOT IGNORE THESE BY DEFAULT #
################################################
# These SHOULD be tracked (for each Unity project):
#
#   <ProjectFolder>/Assets/**
#   <ProjectFolder>/ProjectSettings/**
#   <ProjectFolder>/Packages/**
#   .editorconfig, .gitattributes, .github/workflows, etc.
#
# Only add new ignore rules when:
#  1. The files/folders are 100% auto-generated AND
#  2. They can be recreated by Unity or tooling without manual steps.
################################################
